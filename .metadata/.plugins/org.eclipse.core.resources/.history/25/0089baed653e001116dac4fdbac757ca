/*
 * Write a code to interface LEDs connected to PE8–PE15,
 * a switch at PA0, a relay at PB6,
 * a buzzer at PB5, and
 * an LCD at PORTC such that when the switch is pressed,
 * all LEDs turn ON, the relay is activated,
 * the buzzer beeps for 1 second,
 * and the LCD displays "SYSTEM ON",
 * and when the switch is released,
 * all devices turn OFF and the LCD displays "SYSTEM OFF".
 */


#include <stdint.h>

#define RCC_Base		0x40021000
#define RCC_AHBENR		(*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOA_Base		0x48000000
#define GPIOA_MODER		 (*(volatile uint32_t*)(GPIOA_Base + 0x00))
#define GPIOA_IDR  		 (*(volatile uint32_t*)(GPIOA_Base + 0x10))

#define GPIOB_Base		0x48000400
#define GPIOB_MODER		 (*(volatile uint32_t*)(GPIOB_Base + 0x00))
#define GPIOB_ODR  		 (*(volatile uint32_t*)(GPIOB_Base + 0x14))

#define GPIOE_Base		0x48001000
#define GPIOE_MODER		(*(volatile uint32_t*)(GPIOE_Base + 0x00))
#define GPIOE_ODR		(*(volatile uint32_t*)(GPIOE_Base + 0x14))

#define GPIOC_Base		0x48000800
#define GPIOC_MODER		(*(volatile uint32_t*)(GPIOC_Base + 0x00))
#define GPIOC_ODR		(*(volatile uint32_t*)(GPIOC_Base + 0x14))

#define GPIOD_Base		0x48000c00
#define GPIOD_MODER		(*(volatile uint32_t*)(GPIOD_Base + 0x00))
#define GPIOD_ODR		(*(volatile uint32_t*)(GPIOD_Base + 0x14))

#define PORTA_EN	17
#define PORTB_EN	18
#define PORTC_EN	19
#define PORTD_EN	20
#define PORTE_EN	21

#define RS			0
#define RW			1
#define EN			2

#define switch		0
#define relay		6
#define buzzer		5


void delay_ms(uint16_t i)
{
	while(i)
	{
		for(volatile uint16_t k=0; k<10000; k++);
		i--;
	}
}


void gpio_init(void)
{
	RCC_AHBENR |= (1 << PORTA_EN) | (1 << PORTB_EN) | (1 << PORTC_EN) | (1 << PORTD_EN) | (1 << PORTE_EN);

	GPIOA_MODER &= ~(3 << (0*2));

	GPIOB_MODER &= ~(3 << (buzzer*2) | (3 << (relay*2)));
	GPIOB_MODER |=  (1 << (buzzer*2) | (1 << (relay*2)));


	GPIOC_MODER &= ~((3 << (RS*2)) | (3 << (RW*2)) | (3 << (EN*2)));
	GPIOC_MODER |=  ((1 << (RS*2)) | (1 << (RW*2)) | (1 << (EN*2)));

	GPIOD_MODER &= ~(0xFFFF << (0*2));
	GPIOD_MODER |=  (0x5555 << (0*2));

	GPIOE_MODER &= ~(0xFFFF << (8*2));
	GPIOE_MODER |=  (0x5555 << (8*2));

}

void Enable(void)
{
	GPIOC_ODR |= (1 << EN);
	delay_ms(2);
	GPIOC_ODR &= ~(1 << EN);
	delay_ms(2);
}

void Command(char cmd)
{
		GPIOC_ODR &= ~(1<<RS);
		GPIOC_ODR &= ~(1<<RW);
		GPIOD_ODR = (GPIOD_ODR & 0xFF)|(cmd<<8);
		Enable();
}

void lcd_init(void)
{
	delay_ms(20);
	Command(0x01);
	delay_ms(50);
	Command(0x38);
	delay_ms(50);
	Command(0x0C);
	delay_ms(50);
	Command(0x06);
	delay_ms(50);
	Command(0x01);
	delay_ms(50);

}

void lcd_data(char data)
{
	GPIOC_ODR |=  (1<<RS);
	GPIOC_ODR &= ~(1<<RW);
	GPIOD_ODR = (GPIOD_ODR & 0xFF)|(data<<8);
	Enable();
}

void lcd_string(char *str)
{
	while(*str)
	{
		lcd_data(*str++);
	}
}

int main(void)
{
	gpio_init();
	lcd_init();

	Command(0x01);
	Command(0x80);
while(1)
{

	if(GPIOA_IDR & (1 << switch))
	{
		GPIOE_ODR |= (0xFF << 8);
		GPIOB_ODR |= (1 << buzzer);
		GPIOB_ODR |= (1 << relay);
		lcd_string("SYSTEM ON");
		delay_ms(100);
		GPIOB_ODR &= ~(1 << buzzer);
	}
	else
	{
		GPIOE_ODR &= ~(0xFF << 8);
		GPIOB_ODR &= ~(1 << buzzer);
		GPIOB_ODR &= ~(1 << relay);
		lcd_string("SYSTEM OFF");
	}
	delay_ms(1000);
}
}
