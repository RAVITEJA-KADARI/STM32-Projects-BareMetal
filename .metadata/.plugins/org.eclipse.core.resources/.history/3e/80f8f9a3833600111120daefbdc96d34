//Write a C program to blink all  LEDs connected to pins PE8–PE15 using only GPIO and a software delay loop.

#include <stdint.h>

#define RCC_Base		0x40021000
#define RCC_AHBENR		(*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOE_Base		0x48001000
#define GPIOE_MODER		(*(volatile uint32_t*)(GPIOE_Base + 0x00))
#define GPIOE_ODR		(*(volatile uint32_t*)(GPIOE_Base + 0x14))

#define PORTE_EN		21

#define Switch			0

void delay(void)
{
	for(uint32_t loop = 0; loop < 100000; loop++);
}

int main(void)
{
	RCC_AHBENR |= (1 << PORTE_EN);
	GPIOE_MODER &= ~(0xFFFF << (8*2));
	GPIOE_MODER |=  (0x5555 << (8*2));

	while(1)
	{
		GPIOE_ODR |=  (0xFF00);
		delay();
		GPIOE_ODR &= ~(0xFF00);
	}

	return 0;
}


