#include <stdint.h>


#define RCC_Base   0x40021000
#define RCC_AHBENR    (*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOE_Base    0x48001000
#define GPIOE_MODER   (*(volatile uint32_t*)(GPIOE_Base + 0x00))
#define GPIOE_ODR     (*(volatile uint32_t*)(GPIOE_Base + 0x14))

#define PORTE  21

void delay()
{

		for(uint32_t loop=0;loop<100000;loop++);


}


int main(void)
{

	RCC_AHBENR |=(1<<PORTE);

	//GPIOE clock

	for(int i=8;i<=15;i++)
	{
		GPIOE_MODER &= ~(3<<(i*2));
		GPIOE_MODER |= (1<<(i*2));
	}

	GPIOE_ODR = 0;


	//init_gpio_pin(PORTE);

	while(1)
	{

		//-------- blinking one by one increment--------//
		for(int i=0;i<2;i++)
		{
			for(int i=8;i<=15;i++)
			{
				GPIOE_ODR |= (1<<i);
				delay();

				}
			for(int i=8;i<=15;i++)
			{

				GPIOE_ODR &= ~(1<<i);
				delay();
				}

			}

		//-------- blinking one by one decrement --------//
		for(int i=0;i<2;i++)
		{
			for(int i=15;i>=8;i--)
			{
				GPIOE_ODR |= (1<<i);
				delay();

				}
			for(int i=15;i>=8;i--)
			{

				GPIOE_ODR &= ~(1<<i);
				delay();
				}

			}
		GPIOE_ODR = 0;
		//-------- blinking 2-2 increment --------//
		for(int i=0;i<2;i+=2)
		{
			for(int i=8;i<=15;i+=2)
			{
				GPIOE_ODR |= (1<<i);
				delay();

				}
			for(int i=8;i<=15;i+=2)
			{

				GPIOE_ODR &= ~(1<<i);
				delay();
				}

			}
		GPIOE_ODR = 0;
		//-------- blinking 3-3 increment --------//
		for(int i=0;i<2;i+=3)
		{
			for(int i=8;i<=15;i+=3)
			{
				GPIOE_ODR |= (1<<i);
				delay();

				}
			for(int i=8;i<=15;i+=3)
			{

				GPIOE_ODR &= ~(1<<i);
				delay();
				}

			}
		//-------- blinking increment + decrement --------//
		for(int i=0;i<2;i++)
		{
			for(int i=8;i<=15;i++)
			{
				GPIOE_ODR |= (1<<i);
				delay();

			}
				for(int i=15;i>=8;i--)
					{
						GPIOE_ODR &= ~(1<<i);
						delay();
					}

		}



}
	return 0;

}

