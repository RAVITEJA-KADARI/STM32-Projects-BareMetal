//Write a program to implement a bidirectional running LED pattern on PE8–PE15, where the direction reverses when the user switch (PA0) is pressed.

#include <stdint.h>

#define RCC_Base		0x40021000
#define RCC_AHBENR		(*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOE_Base		0x48001000
#define GPIOE_MODER		(*(volatile uint32_t*)(GPIOE_Base + 0x00))
#define GPIOE_ODR		(*(volatile uint32_t*)(GPIOE_Base + 0x14))

#define GPIOA_Base		0x48000000
#define GPIOA_MODER		(*(volatile uint32_t*)(GPIOA_Base + 0x00))
#define GPIOA_ODR		(*(volatile uint32_t*)(GPIOA_Base + 0x14))
#define GPIOA_IDR		(*(volatile uint32_t*)(GPIOA_Base + 0x10))

#define PORTA_EN		17
#define PORTE_EN		21

#define Switch			0

void delay()
{
	for(volatile uint32_t loop = 0; loop < 100000; loop++);
}

int main(void)
{
	RCC_AHBENR |= (1 << PORTA_EN) | (1 << PORTE_EN);
	GPIOE_MODER &= ~(0xFFFF << (8*2));
	GPIOE_MODER |=  (0x5555 << (8*2));

	GPIOA_MODER &= ~(3 << (0*2));

	while(1)
	{

		//---------increment leds-------//
		for(int i=8;i<16;i++)
		{
			GPIOE_ODR |=  (1 << i);
			delay();
			GPIOE_ODR &= ~(1 << i);
		}

		if(GPIOA_IDR & (1 << Switch))
		{

		//----------decrement leds-------//
		for(int i=16;i>8;i--)
		{
			GPIOE_ODR |=  (1 << i);
			delay();
			GPIOE_ODR &= ~(1 << i);
		}
		}

	}

	return 0;
}
