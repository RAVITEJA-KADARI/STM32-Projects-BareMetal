/*Write a code to interface LEDs connected to PE8–PE15, a switch at PA0, and a buzzer at PB5 such that:

When the switch is pressed, a running LED pattern is generated from PE8 to PE15
The buzzer beeps at each step of the running pattern
When the switch is released, the pattern stops and all LEDs turn OFF*/

#include <stdint.h>

#define RCC_Base		0x40021000
#define RCC_AHBENR		(*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOE_Base		0x48001000
#define GPIOE_MODER		(*(volatile uint32_t*)(GPIOE_Base + 0x00))
#define GPIOE_ODR		(*(volatile uint32_t*)(GPIOE_Base + 0x14))

#define GPIOA_Base		0x48000000
#define GPIOA_MODER		 (*(volatile uint32_t*)(GPIOA_Base + 0x00))
#define GPIOA_IDR  		 (*(volatile uint32_t*)(GPIOA_Base + 0x10))

#define GPIOB_Base		0x48000400
#define GPIOB_MODER		 (*(volatile uint32_t*)(GPIOB_Base + 0x00))
#define GPIOB_ODR  		 (*(volatile uint32_t*)(GPIOB_Base + 0x14))


void delay(uint32_t k)
{
	while(k)
	{
	for(volatile uint32_t i=0;i<100000;i++);
	k--;
	}
}


void gpio_init(void)
{
	RCC_AHBENR |= (1<<17)|(1<<21)|(1<<18);

	GPIOA_MODER &= ~(3 << (0*2)); // PA0 input mode

	GPIOE_MODER &= ~(0xFFFF << (8*2)); //PE8 - PE11 clearing bits
	GPIOE_MODER |=  (0x5555 << (8*2)); // output mode

	GPIOB_MODER &= ~(3 << (5*2)); // clearing Buzzer bits
	GPIOB_MODER |=  (1 << (5*2)); //output mode
}


int main(void)
{

gpio_init();

while(1)
{
	if(GPIOA_IDR & (1 << 0))
	{
		for(int i=8;i<15;i++)
		{
		GPIOE_ODR |= (1 << 1);
		GPIOB_ODR |= (1 << 5);
		delay(10);
		GPIOB_ODR &= ~(1 << 5);
		}
	}
	else
	{
		GPIOE_ODR &= ~(0xFF << 8);
	}
}

}
