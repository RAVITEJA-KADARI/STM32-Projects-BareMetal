/* Write a code to interface a relay connected to PB6 and a buzzer at PB5 such that:

The relay turns ON for 3 seconds and OFF for 3 seconds repeatedly
The buzzer beeps only during the relay ON state*/

#include <stdint.h>

#define RCC_Base		0x40021000
#define RCC_AHBENR		(*(volatile uint32_t*)(RCC_Base + 0x14))

#define GPIOB_Base		0x48000400
#define GPIOB_MODER		 (*(volatile uint32_t*)(GPIOB_Base + 0x00))
#define GPIOB_ODR  		 (*(volatile uint32_t*)(GPIOB_Base + 0x14))


void delay(uint32_t k)
{
	while(k)
	{
	for(volatile uint32_t i=0;i<100000;i++);
	k--;
	}
}


void gpio_init(void)
{
	RCC_AHBENR |= (1<<18);

	GPIOB_MODER &= ~(3 << (5*2)) | (3 << (6*2)); // clearing Buzzer bits
	GPIOB_MODER |=  (1 << (5*2)  | (1 << (6*2)); //output mode
}


int main(void)
{

gpio_init();

while(1)
{

	GPIOB_ODR |= (1 << 5);
	GPIOB_ODR |= (1 << 6);
	delay(3);
	GPIOB_ODR &= ~(1 << 5);
	GPIOB_ODR &= ~(1 << 6);

}
}

