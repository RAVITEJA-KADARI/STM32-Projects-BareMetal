/* USER CODE BEGIN Header_BlinkPE8 */
/**
* @brief Function implementing the Led1Task thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_BlinkPE8 */
void BlinkPE8(void *argument)
{
  /* USER CODE BEGIN BlinkPE8 */
  /* Infinite loop */  for(;;)
  {
    if(buttonPressed)
    {
        GPIOE_ODR |= (1 << LED1_PIN);
    }
    else
    {
        GPIOE_ODR ^= (1 << LED1_PIN);
        osDelay(500);
    }
  }}
  /* USER CODE END BlinkPE8 */


/* USER CODE BEGIN Header_BlinkPE10 */
/**
* @brief Function implementing the Led2Task thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_BlinkPE10 */
void BlinkPE10(void *argument)
{
  /* USER CODE BEGIN BlinkPE10 */
  /* Infinite loop */
	  for(;;)
	  {
	    if(buttonPressed)
	    {
	        GPIOE_ODR |= (1 << LED2_PIN);
	    }
	    else
	    {
	        GPIOE_ODR ^= (1 << LED2_PIN);
	        osDelay(1000);
	    }
	  }
  /* USER CODE END BlinkPE10 */
}

/* USER CODE BEGIN Header_UserButton */
/**
* @brief Function implementing the ButtonTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_UserButton */
void UserButton(void *argument)
{
  /* USER CODE BEGIN UserButton */
  /* Infinite loop */
	for(;;)
	{
	    if(GPIOA_IDR & (1 << BUTTON_PIN))
	        buttonPressed = 1;
	    else
	        buttonPressed = 0;

	    osDelay(50);
	}
  /* USER CODE END UserButton */
}

/* USER CODE BEGIN Header_BlinkPE9 */
/**
* @brief Function implementing the Led3Task thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_BlinkPE9 */
void BlinkPE9(void *argument)
{
  /* USER CODE BEGIN BlinkPE9 */
  /* Infinite loop */
  for(;;)
  {
      GPIOE_ODR ^= (1 << LED3_PIN);
    //  osDelay(1000);
    osDelay(1);
  }
  /* USER CODE END BlinkPE9 */
}

